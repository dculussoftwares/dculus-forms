# Backend API Configuration
# URL of the backend server (GraphQL + REST API)
VITE_API_URL=http://localhost:4000
# GraphQL endpoint URL for admin queries
VITE_GRAPHQL_URL=http://localhost:4000/graphql

# OpenPanel product analytics (optional — leave the client id empty to disable).
# Events go through the first-party /_e path on the site domain.
VITE_OPENPANEL_CLIENT_ID=
# VITE_OPENPANEL_API_URL=/_e
