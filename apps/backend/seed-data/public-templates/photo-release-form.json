  "thumbnailAlt": "Photo Release Form form beside a photo of a photographer captures a smiling woman against a brick wall using a smartphone",
  "content": {
    "intro": "A photo release form is a form that records a person's permission to be photographed and for those images to be used in specific places, such as a website, social media or print, so the photographer or organization has a clear record of consent. This template lets people choose exactly which uses they agree to and includes a parent or guardian section for minors.",
    "audience": "Photographers, schools, nonprofits, event organizers, marketing teams and small businesses using photos of real people.",
    "useCases": [
      "Consent from attendees photographed at a conference, gala or fun run",
      "Model releases for a brand or product photo shoot",
      "School, camp or sports club photos of children, signed by a parent",
      "Customer or staff photos for testimonials, case studies and social media"
    ],
    "tips": [
      "Share a QR code at the event check-in desk so people give consent on their phone before the cameras come out.",
      "Use conditional logic to show the parent or guardian questions only when the person is under 18.",
      "Use the PDF templates feature to generate a filled release for each response, and keep a copy with the photo files."
    ],
    "faq": [
      {
        "question": "What should a photo release form include?",
        "answer": "The person's name and contact details, what the photos are for, where they may be used (website, social media, print, advertising), whether they want a name credit, how long consent lasts and how to withdraw it, parent or guardian consent for minors, a typed full name and the date."
      },
      {
        "question": "Do I need a photo release form for every photo?",
        "answer": "Not always. Rules vary by country and by use. Commercial use, such as advertising, usually needs a release, while editorial or news use often does not. Check your local rules or ask a lawyer for anything high-risk."
      },
      {
        "question": "Is a typed name valid instead of a signature?",
        "answer": "In many places a typed name with a clear consent checkbox and a timestamp is accepted as agreement, but requirements differ by country and use. For high-value commercial shoots, check with a lawyer."
      },
      {
        "question": "Can someone withdraw their photo consent?",
        "answer": "Usually yes, for future use. Say in the form how people can withdraw and what happens to photos already published. Data protection laws such as GDPR give people specific rights over images of them."
      }
    ]
  },
