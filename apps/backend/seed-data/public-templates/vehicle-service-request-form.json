  "name": "Vehicle Service Request",
  "description": "Take car service requests online: owner details, make, model, VIN, mileage, service needed, symptoms and preferred drop-off date.",
  "category": "Business",
  "seoTitle": "Free Vehicle Service Request Form Template",
  "seoDescription": "Vehicle service request form template for auto repair shops: owner contact, make, model, VIN, mileage, service type, warning lights, symptoms and drop-off date.",
  "keywords": [
    "vehicle service request form",
