  "thumbnailAlt": "Vehicle Service Request form beside a photo of a mechanic inspecting a car engine",
  "content": {
    "intro": "A vehicle service request form is a form that collects the owner's contact details, the vehicle's make, model, VIN and mileage, and the service or problem so an auto repair shop can prepare before the car arrives. This template asks about warning lights, symptoms and photos, so your service advisor can order parts and plan bay time before drop-off.",
    "audience": "Independent garages, auto repair shops, tire and quick-lube centers, dealership service departments, mobile mechanics and fleet managers.",
    "useCases": [
      "Online service requests from a garage website outside opening hours",
      "Fleet drivers reporting a vehicle problem to the fleet manager",
      "Seasonal tire change and winter check sign-ups",
      "Mobile mechanics collecting job details before driving out"
    ],
    "tips": [
      "Turn on the email copy for the respondent so the customer has their request details and your shop address.",
      "Use conditional logic to show the symptom questions only when the customer chooses a repair or diagnostic.",
      "Set daily response limits in Form Settings so you never take more requests than your bays can handle."
    ],
    "faq": [
      {
        "question": "What should a vehicle service request form include?",
        "answer": "The owner's name, phone and email; the vehicle year, make, model, VIN, license plate and mileage; the service needed; any warning lights or symptoms; photos if useful; preferred drop-off date; whether they need a loaner or shuttle; and consent to contact them before extra work."
      },
      {
        "question": "Where do I find my VIN?",
        "answer": "The 17-character vehicle identification number is usually on a plate at the base of the windshield on the driver's side, on the driver's door jamb sticker, and on your registration and insurance documents."
      },
      {
        "question": "Does this form book a fixed appointment time?",
        "answer": "No. Customers give a preferred date and time of day, and your shop confirms the actual slot by phone or email. That keeps your schedule in your hands."
      },
      {
        "question": "Why ask customers to approve extra work in advance?",
        "answer": "Inspections often find other issues. Asking whether to call first or proceed up to an agreed amount avoids surprise bills and delays. Rules on written estimates vary by state, so check your local requirements."
      }
    ]
  },
