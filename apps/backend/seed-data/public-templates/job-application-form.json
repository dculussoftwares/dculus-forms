{
  "slug": "job-application-form",
  "name": "Job Application Form",
  "description": "A three-step job application with contact details, role preferences, experience and a résumé upload.",
  "category": "HR & Recruiting",
  "seoTitle": "Free Job Application Form Template with Résumé Upload",
  "seoDescription": "Free online job application form template with résumé and cover letter upload, role, start date and experience questions. Share it on your careers page.",
  "keywords": [
    "job application form",
    "job application form template",
    "online job application",
    "employment application form",
    "careers page form"
  ],
  "tags": [
    "Hiring",
    "File upload",
    "Multi-page"
  ],
  "featured": true,
  "sortOrder": 1,
  "photo": [
    {
      "source": "pexels",
      "id": 5439153
    }
  ],
  "thumbnailAlt": "Job application form next to a photo of a candidate shaking hands at an interview",
  "content": {
    "intro": "Collect complete, comparable applications. Candidates move through three short pages — about them, the role, their experience — and attach their résumé at the end.",
    "audience": "Hiring managers, recruiters and small businesses that hire without an applicant tracking system.",
    "useCases": [
      "A careers page “Apply now” form",
      "Hiring for several open roles with one form",
      "Internship and graduate programmes",
      "Seasonal and part-time hiring"
    ],
    "tips": [
      "List your open roles in the position dropdown so one form covers every vacancy.",
      "Filter responses by position and years of experience to shortlist faster.",
      "Send each application to the hiring manager with an email notification."
    ],
    "faq": [
      {
        "question": "Can candidates upload a résumé?",
        "answer": "Yes. The résumé field accepts PDF and Word files up to 10 MB, stored privately and only visible to your team."
      },
      {
        "question": "Can I use one form for several jobs?",
        "answer": "Yes. Add every open role to the position dropdown, then filter or export responses by role."
      }
    ]
  },
