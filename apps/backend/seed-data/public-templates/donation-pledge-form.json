  "thumbnailAlt": "Donation Pledge form beside a photo of volunteers handing out donations at an outdoor aid table",
  "content": {
    "intro": "A donation pledge form is a form that records a donor's promise to give a set amount over a set period, along with their contact details, the fund it supports and how they want to be recognized, so a nonprofit can track commitments and send reminders. This template collects no money: it captures the pledge, and you share your giving options with the donor afterward.",
    "audience": "Churches, schools, capital campaign committees, community foundations, alumni groups and charity gala organizers.",
    "useCases": [
      "A capital campaign for a new building with multi-year pledges",
      "An annual church stewardship drive",
      "Pledge cards at a gala or fundraising dinner, filled in by QR code",
      "A school or alumni giving day"
    ],
    "tips": [
      "Put a QR code to the form on each table at your event so guests can pledge from their phones during the appeal.",
      "Send the donor an email copy of their pledge with your giving options, using the donor's email field as the recipient.",
      "Send pledges to Google Sheets or export to Excel, then add a column to track gifts received against each pledge."
    ],
    "faq": [
      {
        "question": "What should a donation pledge form include?",
        "answer": "The donor's name and contact details, the total pledge amount, how often and over what period they plan to give, the date of the first gift, the fund or project it supports, how they want to be listed in recognition, any tribute or matching gift details, and a short statement of intent."
      },
      {
        "question": "Is a donation pledge legally binding?",
        "answer": "It depends on the wording and where you are. Many charities treat pledges as statements of intent rather than enforceable contracts, while some written pledges can be enforceable. Check your local rules and accounting guidance."
      },
      {
        "question": "Can donors give money through this form?",
        "answer": "No. This form records the pledge only. Share your online giving page, bank details or check instructions in the confirmation email or thank-you message."
      },
      {
        "question": "How do I follow up on pledges?",
        "answer": "Keep pledges in a spreadsheet using the Google Sheets plugin or an Excel export, note each gift as it arrives, and send reminders before each scheduled date to donors who asked for them."
      }
    ]
  },
