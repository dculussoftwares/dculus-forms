{
  "slug": "volunteer-sign-up-form",
  "name": "Volunteer Sign-up",
  "description": "Recruit volunteers with their interests, availability, skills and an emergency contact — in two quick steps.",
  "category": "Nonprofit",
  "seoTitle": "Free Volunteer Sign-up Form Template",
  "seoDescription": "Free volunteer sign-up form template: interests, availability, skills and emergency contact. Share it with your community and organise volunteers easily.",
  "keywords": [
    "volunteer sign up form",
    "volunteer application form",
    "volunteer registration form",
    "volunteer form template",
    "community volunteer form"
  ],
  "tags": [
    "Volunteers",
    "Community",
    "Nonprofit"
  ],
  "sortOrder": 1,
  "photo": [
    {
      "source": "pexels",
      "id": 6646916
    }
  ],
  "thumbnailAlt": "Volunteer sign-up form over a photo of volunteers handing out food boxes",
  "content": {
    "intro": "Turn interest into a volunteer roster. People tell you how they want to help and when they are free, so you can match them to the right shifts.",
    "audience": "Nonprofits, charities, schools, clubs and community groups that rely on volunteers.",
    "useCases": [
      "Food drives and community kitchens",
      "Charity events and fundraisers",
      "School and parent volunteer programmes",
      "Ongoing volunteer recruitment"
    ],
    "tips": [
      "Filter responses by availability to plan shifts in minutes.",
      "Keep the emergency contact on its own page so it never feels like the first question.",
      "Send new volunteers a welcome email automatically with an email notification."
    ],
    "faq": [
      {
        "question": "Is Dculus Forms free for nonprofits?",
        "answer": "The free plan covers most small volunteer programmes. Dculus Forms is also open source, so you can self-host it at no cost."
      },
      {
        "question": "Can I share this form on social media?",
        "answer": "Yes. Every published form gets a link with a rich preview image, so it looks good on WhatsApp, Facebook and LinkedIn."
      }
    ]
  },
