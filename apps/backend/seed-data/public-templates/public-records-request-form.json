  "name": "Public Records Request",
  "description": "FOIA-style public records request: requester, records sought, date range, department, preferred format and fee waiver details.",
  "category": "Government",
  "seoTitle": "Free Public Records Request Form Template (FOIA)",
  "seoDescription": "Public records request form template for FOIA-style requests: the records sought, date range, department, format, fee limit and requester contact details.",
