  "thumbnailAlt": "Event registration form over a photo of a full conference hall",
  "content": {
    "intro": "Register attendees in two short steps: who they are, then the ticket and sessions they want. Dietary and accessibility questions help you plan the day properly.",
    "audience": "Event organisers running conferences, meetups, workshops, webinars and community events.",
    "useCases": [
      "Conference and summit registration",
      "Meetups and community events",
      "Workshops with limited seats",
      "Hybrid events with in-person and virtual passes"
    ],
    "tips": [
      "Put the ticket question on its own page so people commit to their details first.",
      "Export registrations to Excel or send them to Google Sheets for badge printing.",
      "Ask about dietary and accessibility needs up front — it is far easier than fixing it on the day."
    ],
    "faq": [
      {
        "question": "Can I limit the number of registrations?",
        "answer": "Yes. Set a response limit or a closing date in the form settings and the form closes automatically."
      },
      {
        "question": "Can attendees get a confirmation email?",
        "answer": "Yes. Add an email notification to the respondent and include their ticket type and sessions in the message."
      },
      {
        "question": "Does this work for virtual events?",
        "answer": "Yes. Keep the Virtual pass option and remove the dietary question, or add a field for their time zone."
      }
    ]
  },
