  "content": {
    "intro": "Give visitors one simple place to reach you. This contact form asks only what you need to reply — who they are, how to reach them and what it is about.",
    "audience": "Small businesses, agencies, freelancers and support teams who need a reliable website contact form.",
    "useCases": [
      "A “Contact us” page on your website",
      "Sales and partnership enquiries",
      "Customer support requests before you have a help desk",
      "Press and media contact"
    ],
    "tips": [
      "Keep it short: every extra question lowers how many people finish.",
      "Use the topic question to send each message to the right teammate with an email notification.",
      "Embed the form on your site instead of linking out, so visitors never leave the page."
    ],
    "faq": [
      {
        "question": "Can I put this contact form on my website?",
        "answer": "Yes. Publish it and copy the embed code onto any page, or share the link. Responses arrive in your Dculus Forms workspace."
      },
      {
        "question": "Can I get an email when someone fills it in?",
        "answer": "Yes. Turn on email notifications and every new message is sent to the addresses you choose."
      }
    ]
  },
