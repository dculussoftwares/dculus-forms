  "name": "Conference Registration",
  "description": "Register attendees for a multi-day conference: contact details, pass type, days attending, session picks and dietary needs.",
  "category": "Events",
  "seoTitle": "Free Conference Registration Form Template",
  "seoDescription": "Conference registration form template with attendee details, pass type, days attending, session picks, dietary and access needs. Register attendees online.",
