  "content": {
    "intro": "Skip the paper cards. Guests reply in a minute from their phone, and you see a live count of who is coming and what they will eat.",
    "audience": "Couples and wedding planners collecting RSVPs for a wedding, engagement party or reception.",
    "useCases": [
      "Wedding and reception RSVPs",
      "Engagement parties",
      "Rehearsal dinners",
      "Anniversary celebrations"
    ],
    "tips": [
      "Put the link (or a QR code) on your printed invitation or wedding website.",
      "Export replies to Excel to build the seating plan and send meal counts to the caterer.",
      "Set a closing date a few weeks before the day so your numbers are final in time."
    ],
    "faq": [
      {
        "question": "Can guests reply for their whole household?",
        "answer": "Yes. One reply covers a party — the guest count and the names field tell you exactly who is coming."
      },
      {
        "question": "Can I add my own photo and colours?",
        "answer": "Yes. Open your copy in the builder to change the photo, layout, colours and every question."
      }
    ]
  },
