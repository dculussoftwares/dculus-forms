  "thumbnailAlt": "Restaurant reservation form on a card over a photo of an elegantly set dinner table",
  "content": {
    "intro": "Take table bookings without phone tag. Guests choose a date, time and party size, tell you where they would like to sit and flag allergies before they arrive.",
    "audience": "Restaurants, cafés, bars and supper clubs that want simple online reservations.",
    "useCases": [
      "A “Book a table” button on your website",
      "A link in your Instagram or Google Business profile",
      "Private dining and group booking enquiries",
      "Special-occasion and holiday bookings"
    ],
    "tips": [
      "Edit the time list to match your opening hours and sittings.",
      "Turn on an email notification to the front-of-house inbox for every new booking.",
      "Ask about allergies here so the kitchen knows before service starts."
    ],
    "faq": [
      {
        "question": "Does the form check table availability?",
        "answer": "No — it collects booking requests, which you confirm by email or phone. For automatic availability you would connect it to your booking system with a webhook."
      },
      {
        "question": "Can guests book from their phone?",
        "answer": "Yes. Every layout is built mobile-first, so the form works as well on a phone as on a laptop."
      }
    ]
  },
