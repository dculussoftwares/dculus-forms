  "slug": "personal-training-intake-form",
  "name": "Personal Training Intake",
  "description": "Onboard new PT clients with their goals, training background, PAR-Q health screen, injuries, schedule and coaching preferences.",
  "category": "Wellness & Beauty",
  "seoTitle": "Free Personal Training Intake Form Template",
  "seoDescription": "Personal training intake form template with goals, training history, PAR-Q health screen, injuries, weekly availability and coaching style. Plan session one.",
  "keywords": [
