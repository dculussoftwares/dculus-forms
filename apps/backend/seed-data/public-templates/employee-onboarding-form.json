{
  "slug": "employee-onboarding-form",
  "name": "Employee Onboarding Form",
  "description": "Gather a new hire’s personal details, emergency contact, equipment needs and documents before day one.",
  "category": "HR & Recruiting",
  "seoTitle": "Free Employee Onboarding Form Template",
  "seoDescription": "Free employee onboarding form template: personal details, emergency contact, equipment and system access, ID upload. Send it before a new hire’s first day.",
  "keywords": [
    "employee onboarding form",
    "new hire form",
    "employee information form",
    "onboarding checklist form",
    "new employee form template"
  ],
  "tags": [
    "New hire",
    "HR",
    "Multi-page"
  ],
  "sortOrder": 2,
  "photo": [
    {
      "source": "pexels",
      "id": 3865537
    }
  ],
  "thumbnailAlt": "Employee onboarding form beside a photo of a team stacking hands together",
  "content": {
    "intro": "Send one link before a new hire starts and have everything ready on day one: their details, an emergency contact, the laptop and accounts they need and a photo ID.",
    "audience": "HR teams, office managers and founders onboarding new employees.",
    "useCases": [
      "Pre-boarding a new full-time employee",
      "Onboarding contractors and interns",
      "Collecting IT and equipment requests",
      "Updating employee records"
    ],
    "tips": [
      "Send it a week before the start date so IT has time to order equipment.",
      "Uploaded ID documents are stored privately — add a file field for any other paperwork you need.",
      "Share the form only with the new hire, and restrict who on your team can view responses."
    ],
    "faq": [
      {
        "question": "Is it safe to collect personal details with this form?",
        "answer": "Uploaded files go to private storage and are only reachable by signed-in members with access to the form. You can also self-host Dculus Forms to keep data on your own servers."
      },
      {
        "question": "Can new hires save and finish later?",
        "answer": "Yes. Signed-in respondents can save their progress and come back to finish the form."
      }
    ]
  },
