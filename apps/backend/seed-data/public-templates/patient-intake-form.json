  "name": "Patient Intake Form",
  "description": "A new-patient form covering contact details, insurance, medical history, medications and consent.",
  "category": "Healthcare",
  "seoTitle": "Free Patient Intake Form Template — New Patient Registration",
  "seoDescription": "Free patient intake form template: contact and insurance details, reason for visit, medical history, medications, allergies and consent. Fill it in online.",
  "keywords": [
    "patient intake form",
    "new patient form",
    "patient registration form",
    "medical intake form",
    "clinic intake form template"
