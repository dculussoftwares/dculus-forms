  "thumbnailAlt": "Patient intake form below a photo of nurses at a clinic front desk",
  "content": {
    "intro": "Have new patients complete their paperwork before they arrive. Shorter waiting-room queues, legible answers and records your team can search.",
    "audience": "Clinics, dental practices, physiotherapists, therapists and wellness centres registering new patients.",
    "useCases": [
      "New-patient registration before the first visit",
      "Dental and physiotherapy intake",
      "Telehealth appointment intake",
      "Annual health-record updates"
    ],
    "tips": [
      "Send the link with the appointment confirmation so patients fill it in at home.",
      "Check your local health-privacy rules (for example HIPAA or GDPR) before collecting medical information online.",
      "Limit who in your workspace can view responses with form permissions."
    ],
    "faq": [
      {
        "question": "Where is patient data stored?",
        "answer": "Responses are stored in your Dculus Forms workspace and uploaded files in private storage. For full control, self-host Dculus Forms and keep every record in your own database."
      },
      {
        "question": "Can patients upload their insurance card?",
        "answer": "Yes. The insurance step includes an optional file upload for a photo of the card."
      }
    ]
  },
