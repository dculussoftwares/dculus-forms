  "thumbnailAlt": "Gym Membership Application form beside a photo of group of adults practicing CrossFit with weights in an industrial-style gym",
  "content": {
    "intro": "A gym membership application form collects a new member's contact details, chosen plan, emergency contact and health information, plus their agreement to your gym rules. This template puts all of it in one mobile-friendly form so members can join before they walk in.",
    "audience": "Gyms, fitness studios, CrossFit boxes and community leisure centres signing up new members.",
    "useCases": [
      "New member sign-ups at the front desk on a tablet",
      "Online joining from your website or Instagram bio",
      "Corporate wellness programme enrolment",
      "Seasonal or student membership drives"
    ],
    "tips": [
      "Share the form as a QR code at reception so walk-ins can join on their phone.",
      "Turn on email notifications so the front desk sees each new application right away.",
      "Export applications to Excel or send them to Google Sheets to keep your member list in one place."
    ],
    "faq": [
      {
        "question": "What should a gym membership application include?",
        "answer": "Contact details, date of birth, the membership plan, an emergency contact, a short health questionnaire (PAR-Q style) and agreement to the gym's rules and liability waiver. This template includes all of them."
      },
      {
        "question": "Can members sign up from their phone?",
        "answer": "Yes. Every layout is mobile-first, so members can fill it in from a link, your website or a QR code at the front desk."
      },
      {
        "question": "Can I change the membership plans?",
        "answer": "Yes. Copy the template into your free account and edit the plan options, prices in the labels and every other question in the builder."
      }
    ]
  },
