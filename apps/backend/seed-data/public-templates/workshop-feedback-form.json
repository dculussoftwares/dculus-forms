  "thumbnailAlt": "Workshop feedback form over a soft photo of adults in a training session",
  "content": {
    "intro": "Find out what landed and what did not while the session is fresh. Participants rate the content, pace and instructor, then tell you what to change next time.",
    "audience": "Trainers, teachers, L&D teams and event hosts running workshops, classes and webinars.",
    "useCases": [
      "End-of-workshop evaluation",
      "Corporate training and onboarding sessions",
      "Webinars and online classes",
      "Conference talks and seminars"
    ],
    "tips": [
      "Show a QR code on your last slide and give people two minutes before they leave.",
      "Keep the ratings the same across sessions so you can compare them over time.",
      "Offer a certificate or slides in exchange for an email address."
    ],
    "faq": [
      {
        "question": "Can I make the feedback anonymous?",
        "answer": "Yes. The email question is optional — remove it entirely if you want fully anonymous responses."
      },
      {
        "question": "Can I reuse it for every session?",
        "answer": "Yes. Duplicate the form for each session, or add a session question and filter responses by it."
      }
    ]
  },
