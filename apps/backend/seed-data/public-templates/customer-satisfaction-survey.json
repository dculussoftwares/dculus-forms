  "thumbnailAlt": "Customer satisfaction survey card over a photo of a customer paying at a café counter",
  "content": {
    "intro": "Find out how customers really feel in under a minute. The survey opens with the Net Promoter question, then asks what worked and what did not.",
    "audience": "Shops, cafés, SaaS products, agencies and service businesses that want regular customer feedback.",
    "useCases": [
      "After a purchase or delivery",
      "After a support conversation",
      "Quarterly customer health checks",
      "Post-visit feedback via a QR code at the counter"
    ],
    "tips": [
      "Send it within 24 hours of the experience, while it is still fresh.",
      "NPS = % of 9–10 answers minus % of 0–6 answers. Track it month by month.",
      "Follow up with everyone who scores 6 or below — they tell you what to fix."
    ],
    "faq": [
      {
        "question": "What is the difference between CSAT and NPS?",
        "answer": "CSAT asks how satisfied someone is with one experience. NPS asks how likely they are to recommend you, which tracks long-term loyalty. This template asks both."
      },
      {
        "question": "Can I see the results as charts?",
        "answer": "Yes. Field analytics show the answer breakdown for every question, and you can export everything to Excel."
      }
    ]
  },
