{
  "slug": "time-off-request-form",
  "name": "Time Off Request",
  "description": "Let employees request vacation, PTO, sick or personal days with dates, total days, cover plan and manager details.",
  "category": "HR & Recruiting",
  "seoTitle": "Free Time Off Request Form Template (PTO)",
  "seoDescription": "Time off request form template with leave type, start and end dates, total days, half days, cover plan and manager email. Replace PTO emails with one form.",
  "keywords": [
