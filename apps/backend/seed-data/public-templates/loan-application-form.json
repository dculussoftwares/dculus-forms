  "thumbnailAlt": "Loan Application form beside a photo of a loan advisor meeting a client in an office",
  "content": {
    "intro": "A loan application form is a form that collects an applicant's identity and contact details, the loan amount, purpose and term, employment, income, existing debts and supporting documents so a lender can assess affordability and decide whether to make an offer. This template gathers everything a loan officer needs for a first review in four short steps, and applicants can save progress and come back to upload documents.",
    "audience": "Credit unions, community lenders, microfinance institutions, loan brokers and employers running staff loan programs.",
    "useCases": [
      "Online personal loan applications from your website",
      "Credit union members applying for a car or debt consolidation loan",
      "Broker pre-qualification before submitting to a lender",
      "Employee salary advance or hardship loan programs"
    ],
    "tips": [
      "Turn on save-and-resume so applicants can come back to upload pay stubs without starting over.",
      "Uploads are stored privately; limit who in your team can see responses and export only what you need.",
      "Use conditional logic to ask for employer details only when the applicant is employed, and business details only when self-employed."
    ],
    "faq": [
      {
        "question": "What should a loan application form include?",
        "answer": "The applicant's name, date of birth, contact details and address, the loan amount, purpose and term, employment status and employer, monthly income, housing costs and existing debts, consent to a credit check and uploads of ID and proof of income."
      },
      {
        "question": "What documents are usually needed for a personal loan?",
        "answer": "Most lenders ask for a government photo ID, proof of address, recent pay stubs or bank statements, and tax returns for self-employed applicants. Exact requirements vary by lender and country."
      },
      {
        "question": "Is a credit check consent needed on a loan application?",
        "answer": "Lenders generally need the applicant's permission before running a credit check, and the wording required differs by country. Have your compliance team or legal adviser review the consent text and check your local rules before going live."
      },
      {
        "question": "Is it safe to collect loan applications with an online form?",
        "answer": "Files are stored privately and only people you give access to can view responses. Avoid asking for full card or bank login details on any form, and collect only the personal data you need for the decision."
      }
    ]
  },
