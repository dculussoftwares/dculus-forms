  "thumbnailAlt": "Scholarship Application form beside a photo of young woman engaged in research and writing in a library setting",
  "content": {
    "intro": "A scholarship application form is a form that collects a student's academic record, activities, financial circumstances, a personal essay and supporting documents so a selection committee can award funding on merit, need or both. This template keeps the financial questions optional for merit-only applicants and gathers transcripts and references as private uploads.",
    "audience": "Community foundations, alumni associations, rotary and civic clubs, schools, colleges and family scholarship funds.",
    "useCases": [
      "A local foundation's annual scholarship for graduating high school seniors",
      "A university department award for continuing students",
      "A need-based grant for first-generation college students",
      "A memorial scholarship run by a family or alumni group"
    ],
    "tips": [
      "Use conditional logic to show the household finance page only to applicants who ask for need-based consideration.",
      "Invite committee members to the form so several reviewers can read applications and compare per-question charts.",
      "Set a closing date and time in Form Settings so applications stop exactly at your deadline."
    ],
    "faq": [
      {
        "question": "What should a scholarship application form include?",
        "answer": "Contact details, school and year of study, GPA or grades, intended major, activities and awards, a personal essay, transcript and recommendation letter uploads, and, for need-based awards, household size and income range. End with a statement that the information is true."
      },
      {
        "question": "How long should a scholarship essay be?",
        "answer": "Most scholarships ask for 250 to 650 words. This template caps the essay at 4,000 characters, about 600 to 700 words; change the limit to match your prompt."
      },
      {
        "question": "Should I ask for exact household income?",
        "answer": "Only if your award is need-based, and income ranges are usually enough at the application stage. Ask for tax documents later from finalists only, which limits how much sensitive data you hold."
      },
      {
        "question": "How do I compare applications fairly?",
        "answer": "Export applications to Excel or CSV and score each one against the same rubric, such as academics, essay, activities and need. Removing names from the copy reviewers see helps reduce bias."
      }
    ]
  },
