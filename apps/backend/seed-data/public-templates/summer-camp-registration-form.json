  "thumbnailAlt": "Summer Camp Registration form beside a photo of children building a campfire by a lake",
  "content": {
    "intro": "A summer camp registration form is a form that collects a camper's details, the weeks they will attend, who may pick them up, and their allergies, medications and swim ability so camp staff can keep every child safe. This template groups it into four pages and ends with medical-treatment and photo consent from the parent.",
    "audience": "Day camps, overnight camps, YMCA and community center programs, sports and arts camps, and church or school holiday programs.",
    "useCases": [
      "Weekly day camp where families pick which weeks to book",
      "Overnight camp needing full medical and medication details",
      "Specialty camps such as coding, art, soccer or swim",
      "City recreation department summer programs"
    ],
    "tips": [
      "Use conditional logic to ask for EpiPen or inhaler details only when a parent reports an allergy or asthma.",
      "Check the per-question chart for the weeks question to see how many campers are booked into each week.",
      "Generate a filled PDF per camper with a PDF template so counselors have a printed health sheet on site."
    ],
    "faq": [
      {
        "question": "What should a summer camp registration form include?",
        "answer": "Camper name, date of birth and grade; the weeks and day type booked; parent and emergency contacts; people authorized to pick up; allergies, medications, EpiPen or inhaler use and dietary needs; swim ability; and parent consent for activities, emergency medical treatment and photos."
      },
      {
        "question": "What medical information should a camp collect?",
        "answer": "At minimum: allergies, current medications with doses, conditions such as asthma, diabetes or seizures, emergency medication carried, and immunization records if your camp requires them. Many states license camps and set their own health-form rules, so check your local requirements."
      },
      {
        "question": "Who can see camper health information?",
        "answer": "Only people you give access to the form can see responses, and uploaded health forms are stored privately rather than publicly. Share access only with staff who need it."
      },
      {
        "question": "Can I limit the number of campers?",
        "answer": "Yes. Set a response limit and closing date in Form Settings to cap total registrations. For per-week capacity, watch the weeks question's chart and remove a full week from the options."
      }
    ]
  },
