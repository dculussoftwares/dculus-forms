  "slug": "internship-application-form",
  "name": "Internship Application",
  "description": "Take internship applications with school, major, graduation year, availability, skills, resume and a short motivation answer.",
  "category": "HR & Recruiting",
  "seoTitle": "Free Internship Application Form Template",
  "seoDescription": "Internship application form template with school, major, graduation date, GPA, availability, work authorization, resume upload and why-us answer. Hire faster.",
  "keywords": [
