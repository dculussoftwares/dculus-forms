  "thumbnailAlt": "Internship Application form beside a photo of two women working together at a desk with a laptop",
  "content": {
    "intro": "An internship application form is a form that collects a student's contact details, school, major, graduation date, availability and resume, so an employer can shortlist interns quickly and fairly. This template asks the same questions of every applicant and keeps resumes in private storage, which makes comparing candidates simple.",
    "audience": "Startups, agencies, nonprofits, labs and university career offices recruiting summer, semester or year-round interns.",
    "useCases": [
      "Summer internship hiring at a startup or agency",
      "A university career fair, shared by QR code at the booth",
      "Research lab or nonprofit placements for credit",
      "A rolling, year-round internship program with several teams"
    ],
    "tips": [
      "Share a QR code at career fairs so students can apply on their phone before they leave the booth.",
      "Use conditional logic to show the 'required for credit' details only when a student says the internship is for academic credit.",
      "Set a response limit or a close date in Form Settings so applications stop automatically at your deadline."
    ],
    "faq": [
      {
        "question": "What should an internship application form include?",
        "answer": "Contact details, school, major, degree level and expected graduation date, availability (dates and hours per week), location preference, work authorization, relevant skills, a resume upload, links to a portfolio or LinkedIn, and a short answer on why they want the role."
      },
      {
        "question": "Should I ask for GPA on an internship application?",
        "answer": "It is common but optional. Many employers make GPA optional or skip it to avoid screening out strong candidates, and focus on skills, projects and motivation instead."
      },
      {
        "question": "Can students upload their resume?",
        "answer": "Yes. The resume field accepts PDF or Word files, and uploads are stored privately so only your team can open them."
      },
      {
        "question": "Do interns need to be paid?",
        "answer": "It depends on your country and the type of internship. In the US, for-profit employers generally must pay interns unless the program meets the Department of Labor's primary beneficiary test. Check your local rules."
      }
    ]
  },
